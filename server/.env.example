DATABASE_URL="file:./dev.db"
JWT_SECRET="GENERATE_A_UNIQUE_SECRET_AT_LEAST_32_CHARACTERS_LONG"
# Set LOCAL_LLM_ENABLED=true to keep FamilyPlate prompts on this computer with Ollama.
# When enabled, the configured Ollama model is the only text AI provider used.
LOCAL_LLM_ENABLED="false"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwen3.8-27b:free"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
DEMO_USER_PASSWORD=""
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
# Gemini remains supported as an alternative provider.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
PORT=5000
CLIENT_URL="http://localhost:5173"
